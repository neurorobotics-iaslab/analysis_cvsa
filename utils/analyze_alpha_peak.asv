function [peak_freq] = analyze_alpha_peak(filename, varargin)
% ANALYZE_ALPHA_PEAK Calcola PSD, IAF e Varianza (Specifico per ANT Neuro).
%
% Novità:
% - Mostra la variabilità (Deviazione Standard) tra i canali come area grigia.
% - Evidenzia la banda 8-14 Hz.
% - Filtro Passa-Alto 2Hz incluso.
%
% Usage:
%   peak = analyze_alpha_peak('soggetto01.gdf'); 
%   peak = analyze_alpha_peak('soggetto01.gdf', 'RestTrigger', 786);

    %% 1. Parsing Input
    p = inputParser;
    addRequired(p, 'filename', @ischar);
    addParameter(p, 'RestTrigger', [], @isnumeric);
    parse(p, filename, varargin{:});
    
    rest_typ = p.Results.RestTrigger;
    
    % Canali target (Occipitali/Parietali)
    target_regions = {'O1', 'O2', 'OZ', 'PO7', 'PO8', 'PO3', 'PO4', 'PZ', 'POZ'};
    
    %% 2. Caricamento Dati
    disp('--------------------------------------------------');
    disp(['[INFO] Analisi IAF + Varianza su: ' filename]);
    
    try
        [s, h] = sload(filename);
    catch
        error('Funzione sload non trovata. Installa BIOSIG.');
    end
    
    sampleRate = h.SampleRate;
    
    % Rimuovi canale eventi
    signal_raw = s(:,1:end-1);
    nchannels = size(signal_raw, 2);

    %% 3. Filtro Passa-Alto 2Hz (ANT Fix)
    disp('[INFO] Applicazione Filtro Passa-Alto 2Hz...');
    signal_raw = signal_raw - mean(signal_raw, 1); % Rimuovi DC
    
    cutoff_hz = 2;
    [b_high, a_high] = butter(4, cutoff_hz / (sampleRate/2), 'high');
    signal_clean = filter(b_high, a_high, signal_raw);
    
    %% 4. Selezione Canali
    ch_indices = [];
    if isfield(h, 'Label')
        all_labels = upper(h.Label);
        for i = 1:length(target_regions)
            idx = find(contains(all_labels, target_regions{i}));
            ch_indices = [ch_indices; idx];
        end
        if isempty(ch_indices)
            warning('Canali Occipitali non trovati. Uso tutti i canali.');
            ch_indices = 1:size(signal_clean,2);
        else
            ch_indices = unique(ch_indices);
            disp(['[INFO] Canali analizzati: ' strjoin(h.Label(ch_indices)', ', ')]);
        end
    else
        warning('Nessuna Label. Uso tutti i canali.');
        ch_indices = 1:size(signal_clean,2);
    end

    %% 5. Calcolo PSD
    disp('[INFO] Calcolo PSD e Varianza spaziale...');
    % pwelch parameters -> Tonin suggest these in the presentation
    wshift = 0.0625; % we have new signal after 0.0625 sec
    pshift = 0.25; % shifting inside the windows
    mlength = 1; % moving average
    wlength = 0.5; % in order to have good estimation
    wconv = 'backward';
    f = 4:2:46; % in order to understand interesting features in a smaller
    % number of frequencies
    [PSD, freqs] = proc_spectrogram(signal_clean, wlength, wshift,pshift,sampleRate, mlength); % windows x freq x channels
    [~, ~, idfreq] = intersect(f,freqs);

    disp('  [PROC] updating events from samples to windows');
    event.TYP = h.EVENT.TYP;
    event.POS = proc_pos2win(h.EVENT.POS, wshift*sampleRate, wconv, mlength*sampleRate);
    event.conv = wconv;
    event.SampleRate = sampleRate*wshift*wlength;
    event.DUR = round(h.EVENT.DUR/(wshift*sampleRate)) + 1;


    %% 6. Estrazione Segmenti (Riposo/Fixation)
    
    if ~isempty(rest_typ) && isfield(h, 'EVENT')
        idx_ev = find(event.TYP == rest_typ);
        
        if isempty(idx_ev)
            error(['Trigger ' num2str(rest_typ) ' non trovato.']);
        end
        
        % Calcola la durata minima tra tutti i riposi per coerenza
        mindur_win = min(event.DUR(idx_ev));
        
        % Calcolo quanti windows saltare per rimuovere il primo secondo (transiente)
        skip_win = round(1 / wshift); 
        
        % Se la durata del riposo è troppo breve dopo il taglio, avvisa
        if (mindur_win - skip_win) <= 0
            warning('Durata riposo troppo breve per tagliare 1 secondo. Uso tutto.');
            skip_win = 0;
        end
        
        len_win = mindur_win - skip_win;
        
        % Pre-allocazione: [TotaleWindows x Frequenze x Canali]
        data_segments = nan(len_win * length(idx_ev), length(freqs), length(ch_indices));
        
        fprintf('[INFO] Trovati %d segmenti di riposo. Estraggo %d finestre per trial.\n', length(idx_ev), len_win);
        
        count_win = 0;
        for k = 1:length(idx_ev)
            pos = event.POS(idx_ev(k));
            
            % --- CORREZIONE 2: Gestione indici start/stop ---
            % Start: posizione evento + skip (1 secondo)
            start_w = pos + skip_win; 
            stop_w  = start_w + len_win - 1;
            
            % Controllo bounds
            if stop_w <= size(PSD, 1)
                % Estraggo: [Tempo x Freq x CanaliSelezionati]
                seg = PSD(start_w:stop_w, :, ch_indices);
                
                % Inserisco nella matrice gigante
                idx_insert_start = (k-1)*len_win + 1;
                idx_insert_end   = k*len_win;
                
                data_segments(idx_insert_start:idx_insert_end, :, :) = seg;
            else
                warning('Segmento %d fuori dai limiti del segnale.', k);
            end
        end
    else
        error(['Trigger ' num2str(rest_typ) ' non impostato o eventi assenti.']);
    end
    
    % Rimuovi eventuali NaN se qualche segmento è stato saltato
    if any(isnan(data_segments(:)))
        data_segments = data_segments(~isnan(data_segments(:,1,1)), :, :);
    end
    
    %% Calcolo Statistiche (Media e Varianza)
    
    % --- CORREZIONE 3: Logica di Media ---
    % data_segments è [Tempo x Freq x Canali]
    
    % 1. Media Temporale: Collassiamo il tempo per ogni canale
    % Risultato: [Freq x Canali]
    psd_per_channel = squeeze(mean(data_segments, 1)); 
    
    % 2. Statistiche Spaziali (tra i canali)
    % Media tra i canali (lungo la dimensione 2 di psd_per_channel)
    mean_pxx = mean(psd_per_channel, 2); 
    % Deviazione standard tra i canali
    std_pxx  = std(psd_per_channel, 0, 2); 
    
    % Conversione in dB per il plot
    mean_db = 10*log10(mean_pxx);
    upper_db = 10*log10(mean_pxx + std_pxx);
    
    % Protezione per log
    lower_val = mean_pxx - std_pxx;
    lower_val(lower_val <= 0) = 1e-10; 
    lower_db = 10*log10(lower_val);
    
    %% 7. Ricerca Picco (Banda 8-14 Hz)
    search_mask = (freqs >= 8 & freqs <= 14);
    
    f_band = freqs(search_mask);
    p_band = mean_pxx(search_mask); % Usiamo potenza lineare per cercare il picco
    
    [max_p, idx_max] = max(p_band);
    peak_freq = f_band(idx_max);
    max_p_db = 10*log10(max_p);
    
    %% 8. Visualizzazione
    figure('Color', 'w', 'Name', 'IAF con Varianza (Spectrogram)');
    hold on;
    
    % Plot range (usiamo freqs che ora è 4:2:46)
    plot_mask = (freqs >= 4 & freqs <= 30);
    f_plot = freqs(plot_mask);
    
    % A. Area Varianza
    x_poly = [f_plot; flipud(f_plot)];
    y_poly = [upper_db(plot_mask); flipud(lower_db(plot_mask))];
    
    fill(x_poly, y_poly, [0.85 0.85 0.85], 'EdgeColor', 'none', 'FaceAlpha', 0.6, ...
        'DisplayName', 'Deviazione Standard (Canali)');
    
    % B. Banda Alpha 8-14 Hz
    % Nota: area() disegna da 0 a Y. Per farlo carino sopra la media servirebbe un trucco,
    % ma standard va bene colorare sotto la curva media.
    y_area = mean_db(search_mask);
    if ~isempty(f_band)
        area(f_band, y_area, 'FaceColor', [0.2 0.8 1], 'FaceAlpha', 0.4, ...
            'EdgeColor', 'none', 'DisplayName', 'Banda Alpha (8-14 Hz)');
    end
    
    % C. Media
    plot(f_plot, mean_db(plot_mask), 'k', 'LineWidth', 2, 'DisplayName', 'PSD Media');
    
    % D. Picco
    plot(peak_freq, max_p_db, 'ro', 'MarkerSize', 8, 'MarkerFaceColor', 'r', 'DisplayName', 'IAF Peak');
    
    xline(peak_freq, 'r--');
    text(peak_freq + 0.5, max_p_db, sprintf('IAF: %.1f Hz', peak_freq), ...
        'Color', 'r', 'FontSize', 12, 'FontWeight', 'bold');
    
    title(['Spettro di Potenza (HP 2Hz) - IAF: ' num2str(peak_freq) ' Hz']);
    xlabel('Frequenza (Hz)');
    ylabel('Potenza (dB/Hz)');
    legend('Location', 'northeast');
    grid on;
    xlim([4 30]);
    
    fprintf('\n   >>> PICCO ALPHA (8-14 Hz): %.2f Hz <<<\n', peak_freq);
end